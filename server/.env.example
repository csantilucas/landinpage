PORT=5000
NODE_ENV=development
# Configure uma ou múltiplas origens/IPs separados por vírgula:
# Exemplos:
# CLIENT_URL=http://192.168.1.27:3000
# CLIENT_URL=http://localhost:3000,http://192.168.1.27:3000,https://landinpage-kappa.vercel.app
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.27:3000

# String de conexão do Microsoft SQL Server para o Prisma:
# Formato: sqlserver://<HOST>:<PORT>;database=<DB_NAME>;user=<USER>;password=<PASSWORD>;encrypt=true;trustServerCertificate=true;
DATABASE_URL="sqlserver://localhost:1433;database=trr_krupinski;user=sa;password=YourPassword123!;encrypt=true;trustServerCertificate=true;"
BETTER_AUTH_SECRET=definir_chave_secreta_aleatoria_com_pelo_menos_32_caracteres
BETTER_AUTH_URL=http://localhost:5000
COMMODITIES_CACHE_TTL_MINUTES=60    